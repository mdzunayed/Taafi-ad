# Origin + prefix of the Taafi API. The portal derives the bare origin from
# this and appends its own per-domain prefixes, because /api/v1 only aliases
# auth/admin/provider — the CMS routers live at /api/* with no v1 alias.
NEXT_PUBLIC_API_BASE_URL=https://taafi-backend.onrender.com/api/v1

# Server-side only. Used by the BFF route handlers under app/api/auth/* to
# reach Express. Defaults to the origin derived from the URL above.
API_ORIGIN=https://taafi-backend.onrender.com

# `NEXT_PUBLIC_API_URL` and `API_URL` are accepted as aliases for the two
# above (see lib/config/env.ts); the *_BASE_URL / *_ORIGIN pair wins if both
# are set. Either spelling may carry an `/api` or `/api/v1` suffix or not —
# the origin is derived either way.

# ── Pointing at a local backend instead ───────────────────────────────────
#   NEXT_PUBLIC_API_BASE_URL=http://localhost:5000/api/v1
#   API_ORIGIN=http://localhost:5000
# Port 5000 is the bare `npm run dev` port for ../backend; its docker-compose
# stack publishes 4000 instead.
#
# The browser-side value also drives the Socket.io connection, so REST and
# WebSocket follow it together — there is no separate socket URL to set.

# ── CORS, for the deployed API ────────────────────────────────────────────
# Running `npm run dev` here against the Render host needs NO dashboard
# change: ADMIN_DEV_ORIGINS in backend/src/middleware/security.js merges
# http://localhost:3000 and http://127.0.0.1:3000 into the allow-list
# unconditionally, in every environment. (Verified against the live host on
# 2026-09-05: a preflight from http://localhost:3000 returns 204 with the
# matching Access-Control-Allow-Origin, while an unknown origin gets none.)
#
# Once this console has a deployed origin of its own, name it in
# CORS_ALLOWED_ORIGINS on the Render dashboard. Do not leave that unset: an
# empty list does NOT fail closed — the API reflects EVERY browser origin
# with credentials enabled.
#
# Socket.io runs a SEPARATE origin check (SOCKET_ORIGIN). Unset, it now falls
# through to the same allow-list as REST, so the two cannot drift apart.
